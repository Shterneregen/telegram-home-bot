# Persistent H2 database inside the ./data bind mount
DB_URL=jdbc:h2:/app/data/thb
DB_USERNAME=sa
DB_PASSWORD=
SERVER_PORT=9988

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_BOT_CHAT_ID=
TELEGRAM_HOME_GROUP_USER_IDS=

# OpenWeatherMap
OPENWEATHER_ENABLED=false
OPENWEATHER_APPID=

# Local network monitoring
NETWORK_MONITOR_ENABLED=false
NETWORK_MONITOR_AUTO_DETECT=true
NETWORK_MONITOR_INTERFACE=
NETWORK_MONITOR_LAN_CIDR=
NETWORK_MONITOR_MAX_SCAN_ADDRESSES=1024
BROADCAST_PING_COMMAND_LINUX=

# Optional Wake-on-LAN override. By default, broadcast is detected from the LAN.
WAKE_ON_LAN_BROADCAST_IP=

# Commands (both Telegram transports and web actions): bounded execution and captured output.
COMMAND_TIMEOUT_SECONDS=30
COMMAND_MAX_OUTPUT_BYTES=65536

# TLS. Keep disabled when HTTPS is terminated by a reverse proxy.
SSL_ENABLED=false
SSL_KEY_STORE=file:/app/secrets/thb-keystore.p12
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12
SSL_KEY_ALIAS=thb

# Telegram transport: bot-api (default) or mtproto
TELEGRAM_TRANSPORT=bot-api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=443
# Entire ee-prefixed hex secret, including encoded domain
TELEGRAM_PROXY_SECRET=
TELEGRAM_TDLIB_DATA_DIR=/app/data/tdlib
# Explicit local networks needed by monitor/WoL/remote commands (RFC1918 only).
TELEGRAM_EGRESS_LAN_CIDRS=
